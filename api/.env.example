ENVIRONMENT=local

# Runtime connection — the low-privilege tallyquo_app role (no BYPASSRLS).
# The API only ever connects with this DSN, in every environment. Get the
# real value from the Supabase dashboard: Project (tallyquo, ca-central-1)
# > Connect > Session pooler. Direct/IPv6 connections don't work from most
# networks (including Render and GitHub Actions) — use the pooler.
DATABASE_URL=postgresql+asyncpg://tallyquo_app.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Local-Postgres-only migration/admin connection. Only needed if you run
# `alembic upgrade head` or `pytest` against local Docker Postgres — see
# README.md "Running the test suite locally". Not used against Supabase;
# schema changes there go through the Supabase MCP `apply_migration` tool.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5435/tallyquo

# Object storage — Supabase Storage's S3-compatible endpoint for the same
# project. The `tallyquo` bucket exists (private). Generate S3 access keys
# from the dashboard (Storage > S3 Access Keys) when the first upload
# endpoint is built — none exist yet as of Phase 0.
STORAGE_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=ca-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=tallyquo
SIGNED_URL_TTL_SECONDS=300

# Vite dev server origin, for CORS.
ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
