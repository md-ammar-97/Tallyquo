ENVIRONMENT=local

# Runtime connection — the low-privilege tallyquo_app role (no BYPASSRLS).
# The API only ever connects with this DSN.
DATABASE_URL=postgresql+asyncpg://tallyquo_app:tallyquo_app@localhost:5435/tallyquo

# Migration connection — admin role, used only by Alembic.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5435/tallyquo

# Object storage — Supabase Storage's S3-compatible endpoint. Leave blank
# locally until a Supabase project exists; storage.py fails loudly rather
# than silently no-op-ing if something tries to use it unconfigured.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=tallyquo
SIGNED_URL_TTL_SECONDS=300

LOG_LEVEL=INFO
